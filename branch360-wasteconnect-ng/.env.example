# Google reCAPTCHA v2 — https://www.google.com/recaptcha/admin
# Create keys for your domain (e.g. iinvest-nigeria-gateway.vercel.app and localhost)

# Public — used in the browser (Vite)
VITE_RECAPTCHA_SITE_KEY=your_recaptcha_site_key_here

# Secret — server only; set in Vercel → Settings → Environment Variables
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key_here
